@model RegisterModel
@{ ViewData["Title"] = "Create account"; }
<div class="panel narrow"><p class="eyebrow">START YOUR JOURNEY</p><h1>Create an account</h1><p class="muted">Free enrollment. One place for every exam.</p><form method="post" asp-action="Register"><div asp-validation-summary="All" class="validation"></div><label asp-for="Name"></label><input asp-for="Name" autocomplete="name"/><label asp-for="Email"></label><input asp-for="Email" autocomplete="email"/><label asp-for="Password"></label><input asp-for="Password" autocomplete="new-password"/><small>At least 8 characters, including uppercase, lowercase, and a number.</small><button class="wide">Create student account</button></form><a asp-action="Login">Already registered? Sign in</a></div>
