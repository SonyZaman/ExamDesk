@model LoginModel
@{ ViewData["Title"] = "Welcome back"; }
<section class="auth"><div><p class="eyebrow">YOUR LEARNING, IN ONE PLACE</p><h1>Ready for your<br/>next milestone?</h1><p class="lead">Join your batches, take your exams, and see your progress. Your next chapter starts here.</p><div class="illustration">Learn.<br/>Practice.<br/><strong>Progress.</strong></div></div><div class="panel"><p class="eyebrow">EXAMDESK</p><h2>Welcome back</h2><p class="muted">Sign in to your workspace.</p><form method="post" asp-action="Login"><div asp-validation-summary="All" class="validation"></div><label asp-for="Email"></label><input asp-for="Email" autocomplete="username"/><label asp-for="Password"></label><input asp-for="Password" autocomplete="current-password"/><button class="wide">Sign in →</button></form><p>New here? <a asp-action="Register">Create a student account</a></p></div></section>
