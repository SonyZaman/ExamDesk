<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · ExamDesk</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head>
<body><header><a class="brand" asp-controller="Portal" asp-action="Index"><span class="logo">E</span> ExamDesk</a><nav>@if(User.Identity?.IsAuthenticated == true){<a asp-controller="Portal" asp-action="Index">Dashboard</a>@if(User.IsInRole("Admin")){<a asp-controller="Portal" asp-action="Users">Manage users</a>}<form asp-controller="Account" asp-action="Logout" method="post"><button class="quiet">Sign out</button></form>}else{<a asp-controller="Account" asp-action="Login">Sign in</a><a class="button" asp-controller="Account" asp-action="Register">Create account</a>}</nav></header>
<main>@if(TempData["Success"] is string success){<div class="notice" role="status">@success</div>}@if(TempData["Error"] is string error){<div class="notice error" role="alert">@error</div>}@RenderBody()</main><footer>ExamDesk · A clearer path from preparation to progress.<span>All schedules shown in Bangladesh time (UTC+6)</span></footer></body></html>
