@model EditBatchModel
@{ ViewData["Title"] = "Edit batch"; }
<div class="panel narrow"><h1>Edit batch</h1><form method="post"><div asp-validation-summary="All" class="validation"></div><label asp-for="Name"></label><input asp-for="Name"/><label asp-for="Description"></label><textarea asp-for="Description"></textarea><label asp-for="EnrollmentDeadline">Enrollment deadline (Bangladesh time; optional)</label><input asp-for="EnrollmentDeadline" type="datetime-local"/><label asp-for="Status"></label><select asp-for="Status" asp-items="Html.GetEnumSelectList<BatchStatus>()"></select><button>Save changes</button></form><a asp-action="Index">Cancel</a></div>
