@model DashboardModel
@inject UserManager<ApplicationUser> Users
@{ ViewData["Title"] = "Dashboard"; var uid = Users.GetUserId(User); var staff = User.IsInRole("Admin") || User.IsInRole("Instructor"); var person = await Users.GetUserAsync(User); }
<div class="pagehead"><div><p class="eyebrow">@(staff ? "TEACHING WORKSPACE" : "STUDENT WORKSPACE")</p><h1>Hello, @(person?.Name ?? "there") 👋</h1><p class="muted">Everything you need for your next exam, right here.</p></div><span class="badge">@(User.IsInRole("Admin") ? "Admin" : staff ? "Instructor" : "Student")</span></div>
<section class="stats"><article><span>Available batches</span><strong>@Model.Batches.Count</strong></article><article><span>Scheduled exams</span><strong>@Model.Exams.Count</strong></article><article><span>Published results</span><strong>@Model.Results.Count</strong></article></section>
<div class="sectionhead"><h2>Your exam calendar</h2><span class="muted">Bangladesh time</span></div>
<div class="panel">@if(Model.Exams.Count == 0){<div class="empty"><h3>Your next chapter starts with a batch</h3><p>Enroll below to see scheduled exams here.</p></div>}else{<div class="tablewrap"><table><thead><tr><th>Exam</th><th>Starts</th><th>Full marks</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var exam in Model.Exams){<tr><td><strong>@exam.Title</strong><small>@exam.Batch.Name</small></td><td>@exam.QuestionReleaseAtUtc.ToOffset(TimeSpan.FromHours(6)).ToString("dd MMM yyyy · hh:mm tt")</td><td>@exam.FullMarks</td><td><span class="badge">@(exam.ResultPublishedAtUtc != null ? "Results published" : exam.CanSubmit(DateTimeOffset.UtcNow) ? "Open now" : DateTimeOffset.UtcNow < exam.QuestionReleaseAtUtc ? "Upcoming" : "Closed")</span></td><td><a asp-action="Exam" asp-route-id="@exam.Id">View exam →</a></td></tr>}</tbody></table></div>}</div>
<div class="sectionhead"><h2>Explore batches</h2><span class="muted">Build your preparation, one exam at a time</span></div><section class="cards">@foreach(var batch in Model.Batches){<article class="panel"><span class="badge">@batch.Status</span><h3>@batch.Name</h3><p class="muted">@batch.Description</p><p>@batch.Exams.Count exams · @batch.Enrollments.Count enrolled</p>@if(User.IsInRole("Admin") || (User.IsInRole("Instructor") && batch.InstructorId == uid)){<a class="button" asp-action="CreateExam" asp-route-id="@batch.Id">+ Schedule exam</a><p><a asp-action="EditBatch" asp-route-id="@batch.Id">Edit batch</a> · <a asp-action="DeleteBatch" asp-route-id="@batch.Id">Delete batch</a></p>}else if(batch.Enrollments.Any(x => x.StudentId == uid)){<span class="badge">✓ Enrolled</span>}else if(User.IsInRole("Student")){<form asp-action="Enroll" asp-route-id="@batch.Id" method="post"><button>Enroll for free →</button></form>}@if(User.IsInRole("Admin") || (User.IsInRole("Instructor") && batch.InstructorId == uid) || batch.Enrollments.Any(x => x.StudentId == uid && x.Status == EnrollmentStatus.Active)){<p><a class="button" asp-action="Leaderboard" asp-route-id="@batch.Id">Batch leaderboard →</a></p>}</article>}</section>
@if(staff){<section class="panel"><h2>Create an exam batch</h2><form asp-action="CreateBatch" method="post"><label for="name">Batch name</label><input id="name" name="name" required maxlength="200" placeholder="e.g. BUET MSc CSE Preparation"/><label for="description">Description</label><textarea id="description" name="description" maxlength="2000" placeholder="What will students prepare for?"></textarea><button>Create & open enrollment</button></form></section>}
