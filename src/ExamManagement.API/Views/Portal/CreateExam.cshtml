@model ExamModel
@{ ViewData["Title"] = "Schedule exam"; }
<div class="panel narrow"><p class="eyebrow">PLAN THE NEXT CHALLENGE</p><h1>Schedule an exam</h1><p class="muted">Enter all times in Bangladesh time (UTC+6).</p><form asp-action="CreateExam" method="post"><div asp-validation-summary="All" class="validation"></div><input asp-for="BatchId" type="hidden"/><label asp-for="Title"></label><input asp-for="Title"/><label asp-for="FullMarks">Full marks</label><input asp-for="FullMarks"/><label asp-for="Release">Question release</label><input asp-for="Release" type="datetime-local"/><label asp-for="End">Exam ends</label><input asp-for="End" type="datetime-local"/><label asp-for="Deadline">Answer submission deadline</label><input asp-for="Deadline" type="datetime-local"/><button class="wide">Schedule exam</button></form></div>
