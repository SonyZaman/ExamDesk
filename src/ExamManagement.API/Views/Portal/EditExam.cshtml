@model ExamModel
@{ ViewData["Title"] = "Edit exam"; }
<div class="panel narrow"><h1>Edit exam</h1><p>Times are in Bangladesh time (UTC+6). Changes apply immediately. Existing submissions and published grades remain; changing full marks changes percentage rankings.</p><form method="post"><div asp-validation-summary="All" class="validation"></div><label asp-for="Title"></label><input asp-for="Title"/><label asp-for="FullMarks">Full marks</label><input asp-for="FullMarks"/><label asp-for="Release">Question release</label><input asp-for="Release" type="datetime-local"/><label asp-for="End">Exam ends</label><input asp-for="End" type="datetime-local"/><label asp-for="Deadline">Submission deadline</label><input asp-for="Deadline" type="datetime-local"/><button>Save changes</button></form><a asp-action="Index">Cancel</a></div>
