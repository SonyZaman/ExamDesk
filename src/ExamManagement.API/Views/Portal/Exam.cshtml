@model ExamPage
@if(Model.CanManage){<p><a asp-action="EditExam" asp-route-id="@Model.Exam.Id">Edit exam</a> · <a asp-action="DeleteExam" asp-route-id="@Model.Exam.Id">Delete exam</a></p>}
<p><a asp-action="Leaderboard" asp-route-id="@Model.Exam.BatchId">View batch leaderboard →</a></p>
@{ ViewData["Title"] = Model.Exam.Title; var exam = Model.Exam; string Time(DateTimeOffset t) => t.ToOffset(TimeSpan.FromHours(6)).ToString("dd MMM · hh:mm tt"); }
<a asp-action="Index">← Dashboard</a><div class="pagehead"><div><p class="eyebrow">@exam.Batch.Name</p><h1>@exam.Title</h1></div><span class="badge">@exam.FullMarks marks</span></div>
<section class="stats"><article><span>Question release</span><h3>@Time(exam.QuestionReleaseAtUtc)</h3></article><article><span>Exam ends</span><h3>@Time(exam.ExamEndAtUtc)</h3></article><article><span>Submission deadline</span><h3>@Time(exam.SubmissionDeadlineAtUtc)</h3></article></section>
<section class="cards"><article class="panel"><h2>Question paper</h2><p class="muted">Questions are available during the exam window.</p>@if(exam.QuestionFiles.Any() && (Model.CanManage || (exam.CanViewQuestion(DateTimeOffset.UtcNow) && DateTimeOffset.UtcNow <= exam.ExamEndAtUtc))){<a class="button" asp-action="DownloadQuestion" asp-route-id="@exam.Id">Download question PDF</a>}else{<p class="badge">Question paper unavailable</p>}@if(Model.CanManage){<form method="post" asp-action="Question" asp-route-id="@exam.Id" enctype="multipart/form-data"><label for="pdf">Upload PDF · maximum 10 MB</label><input id="pdf" type="file" name="file" accept="application/pdf" required/><button>Upload question</button></form>}</article>
@if(Model.Enrolled){<article class="panel"><h2>Your answer sheets</h2>@if(Model.Submission != null){<p class="badge">✓ Submitted @Time(Model.Submission.SubmittedAtUtc!.Value)</p>@foreach(var file in Model.Submission.Files.OrderBy(x => x.PageNumber)){<p><a asp-action="Answer" asp-route-id="@file.Id" target="_blank" rel="noopener">View page @file.PageNumber ↗</a></p>}@if(exam.ResultPublishedAtUtc != null){<h3>@Model.Submission.Evaluation?.Marks / @exam.FullMarks</h3><p>@Model.Submission.Evaluation?.Feedback</p>}}else if(exam.CanSubmit(DateTimeOffset.UtcNow)){<p class="muted">Submit once. Select 1–5 JPG or PNG pages, up to 10 MB each. Upload must finish before the deadline.</p><form asp-action="Submit" asp-route-id="@exam.Id" method="post" enctype="multipart/form-data"><label for="answers">Answer images in page order</label><input id="answers" name="files" type="file" multiple accept="image/jpeg,image/png" required/><button>Submit final answers</button></form>}else{<p class="muted">Submissions are currently closed.</p>}</article>}</section>
@if(Model.CanManage){<div class="sectionhead"><h2>Review submissions</h2><span class="badge">@Model.Submissions.Count submitted</span></div>@foreach(var submission in Model.Submissions){<article class="panel"><h3>@Model.Names.GetValueOrDefault(submission.StudentId, "Student")</h3><div class="answerlinks">@foreach(var file in submission.Files.OrderBy(x => x.PageNumber)){<a asp-action="Answer" asp-route-id="@file.Id" target="_blank" rel="noopener">Page @file.PageNumber ↗</a>}</div><form asp-action="Grade" asp-route-id="@submission.Id" method="post"><label for="marks-@submission.Id">Marks out of @exam.FullMarks</label><input id="marks-@submission.Id" type="number" name="marks" min="0" max="@exam.FullMarks" step="0.01" value="@submission.Evaluation?.Marks" required/><label for="feedback-@submission.Id">Feedback</label><textarea id="feedback-@submission.Id" name="feedback" maxlength="5000">@submission.Evaluation?.Feedback</textarea>@if(exam.ResultPublishedAtUtc == null){<button>Save evaluation draft</button>}</form></article>}@if(exam.ResultPublishedAtUtc == null){<section class="panel"><h3>Publish results</h3><p>After the deadline, publish all graded results together. Missing answers receive zero. Published marks are locked.</p><form asp-action="Publish" asp-route-id="@exam.Id" method="post"><button>Publish results & leaderboard</button></form></section>}}
<section class="panel"><h2>Exam leaderboard</h2>@if(exam.ResultPublishedAtUtc == null){<p class="muted">Rankings appear after results are published.</p>}else{<table><thead><tr><th>Rank</th><th>Student</th><th>Marks</th></tr></thead><tbody>@foreach(var result in Model.Results.OrderByDescending(x => x.Marks)){<tr><td>#@(1 + Model.Results.Count(x => x.Marks > result.Marks))</td><td>@Model.Names.GetValueOrDefault(result.StudentId, "Student")</td><td>@result.Marks / @exam.FullMarks</td></tr>}</tbody></table>}</section>
